#!/bin/bash

# --------------------------------------------------------------------------- #
#                       SHELL OPTIONS
# --------------------------------------------------------------------------- #

# 'set -e' is deliberately omitted: every failure is handled explicitly
# so that partial output can be cleaned up before exiting.
set -uo pipefail

# Output files must never be group- or world-accessible, not even while
# 'age' is still writing plaintext into them.
umask 077

# --------------------------------------------------------------------------- #
#                       VARIABLE DEFINITIONS
# --------------------------------------------------------------------------- #

PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin

readonly _action="${1-}"
readonly _infile="${2-}"
readonly _nargs="$#"
readonly _ext='age'

# Set by encrypt_file/decrypt_file while the output is still incomplete,
# so that the interrupt trap can remove the staged temp file.
_pending_outfile=''

# --------------------------------------------------------------------------- #
#                       FUNCTIONS
# --------------------------------------------------------------------------- #

errout() {
        local _msg="${0##*/} error: ${*}"
        printf '%s\n' "${_msg}" >&2
        exit 1
}

print_usage_and_exit() {
        printf '%s\n' "Usage: ${0##*/} lock|unlock input-file" >&2
        exit 1
}

# Invoked indirectly, via 'trap'; the trap lines exit with 128+signo
# after calling it, so no success message can follow an interruption.
# shellcheck disable=SC2317
cleanup_pending_outfile() {
        if [ -z "${_pending_outfile}" ] ; then
                return
        fi

        printf '\n%s\n' \
                "Interrupted: removing incomplete ${_pending_outfile}" >&2
        rm -f -- "${_pending_outfile}"
}

audit_age() {
        if ! command -v age >/dev/null 2>&1 ; then
                errout "Install the 'age' program into one of: ${PATH//:/ }"
        fi
}

audit_cliargs() {
        if [ "${_nargs}" -ne 2 ] ; then
                print_usage_and_exit
        fi

        if [ "${_action}" == 'lock' ] ; then
                :
        elif [ "${_action}" == 'unlock' ] ; then
                :
        else
                print_usage_and_exit
        fi

        if [ -z "${_infile}" ] ; then
                print_usage_and_exit
        fi

        if [ ! -f "${_infile}" ] ; then
                errout "${_infile} not found"
        fi
}

audit_pubkey() {
        # An age recipient is 'age1' followed by 58 bech32 characters.
        if ! grep -Eq '^age1[02-9ac-hj-np-z]{58}$' <<<"${_pubkey}" ; then
                errout "Invalid public key format"
        fi
}

# GNU '%a' and BSD/macOS '%Lp' both print permission bits in octal,
# so no conversion is needed. Non-zero return means neither worked.
# BSD 'stat' takes no '--', so a leading dash is neutralised with
# a './' prefix instead; GNU keeps its documented '--'.
get_file_perms() {
        local _file="$1"

        case "${_file}" in
                -*)     _file="./${_file}" ;;
        esac

        stat -c '%a' -- "${_file}" 2>/dev/null && return 0
        stat -f '%Lp' "${_file}" 2>/dev/null
}

audit_private_key_file() {
        local _perms

        if [ ! -f "${_private_key_file}" ] ; then
                errout "Private key file (${_private_key_file}) not found"
        fi

        if [ ! -r "${_private_key_file}" ] ; then
                errout "Private key file (${_private_key_file}) is unreadable"
        fi

        _perms=$(get_file_perms "${_private_key_file}") ||
                errout "Cannot determine permissions of ${_private_key_file}"

        if [ "${_perms}" != '600' ] ; then
                errout "Private key file must have 600 permissions" \
                       "(found: ${_perms})"
        fi
}

set_pubkey() {
        local _key

        # Tolerate a key pasted with surrounding whitespace or newlines.
        _key="$(printf '%s' "${JIE_SUO_PUBKEY:-}" | tr -d '[:space:]')"
        readonly _pubkey="${_key}"

        if [ -z "${_pubkey}" ] ; then
                errout "Set \$JIE_SUO_PUBKEY in environment"
        fi
}

set_private_key_file() {
        readonly _private_key_file="${JIE_SUO_PRIVATE_KEY_FILE:-}"

        if [ -z "${_private_key_file}" ] ; then
                errout "Set \$JIE_SUO_PRIVATE_KEY_FILE in environment"
        fi
}

encrypt_file() {
        local _outfile="${_infile##*/}.${_ext}"
        local _tmpfile

        if [ -e "${_outfile}" ] || [ -L "${_outfile}" ] ; then
                errout "${_outfile} already exists"
        fi

        # 'mktemp' creates with O_EXCL, so a planted symlink or
        # PID-guessed name can never hijack the staged output.
        _tmpfile="$(mktemp "./${_outfile}.tmp.XXXXXX")" ||
                errout "Cannot create temporary file"

        _pending_outfile="${_tmpfile}"

        if ! age                                                        \
        -r "${_pubkey}"                                                 \
        -o "${_tmpfile}"                                                \
        --                                                              \
        "${_infile}" ; then
                printf '%s\n' "Removing incomplete ${_tmpfile}" >&2
                rm -f -- "${_tmpfile}"
                errout 'Problem encrypting'
        fi

        # '-n' never overwrites; a skipped rename leaves the temp
        # behind, which the next check turns into 'already exists'.
        if ! mv -n -- "${_tmpfile}" "${_outfile}" ; then
                rm -f -- "${_tmpfile}"
                errout "Cannot rename output to ${_outfile}"
        fi

        if [ -e "${_tmpfile}" ] || [ -L "${_tmpfile}" ] ; then
                rm -f -- "${_tmpfile}"
                errout "${_outfile} already exists"
        fi

        _pending_outfile=''

        printf '%s\n' "Encrypted output file is ${_outfile}"
}

decrypt_file() {
        local _outfile
        local _tmpfile

        case "${_infile}" in
                *."${_ext}")    ;;
                *)              errout "I only decrypt .${_ext} files" ;;
        esac

        # Remove the extension and put outfile in cwd
        _outfile="${_infile%."${_ext}"}"
        _outfile="${_outfile##*/}"

        if [ -z "${_outfile}" ] ; then
                errout "Cannot derive an output file name from ${_infile}"
        fi

        if [ -e "${_outfile}" ] || [ -L "${_outfile}" ] ; then
                errout "${_outfile} already exists"
        fi

        _tmpfile="$(mktemp "./${_outfile}.tmp.XXXXXX")" ||
                errout "Cannot create temporary file"

        _pending_outfile="${_tmpfile}"

        if ! age                                                        \
        -d                                                              \
        -i "${_private_key_file}"                                       \
        -o "${_tmpfile}"                                                \
        --                                                              \
        "${_infile}" ; then
                printf '%s\n' "Removing incomplete ${_tmpfile}" >&2
                rm -f -- "${_tmpfile}"
                errout 'Problem decrypting'
        fi

        if ! mv -n -- "${_tmpfile}" "${_outfile}" ; then
                rm -f -- "${_tmpfile}"
                errout "Cannot rename output to ${_outfile}"
        fi

        if [ -e "${_tmpfile}" ] || [ -L "${_tmpfile}" ] ; then
                rm -f -- "${_tmpfile}"
                errout "${_outfile} already exists"
        fi

        _pending_outfile=''

        printf '%s\n' "Decrypted output file is ${_outfile}"
}

print_secret_cleanup_msg() {
        printf '\n%s\n%s\n' \
                "*** Remove ${_private_key_file} securely when done: ***" \
                "*** 'shred -u' (GNU/Linux) or 'rm -P' (BSD/macOS) ***" >&2
}

# -------------------------------------------------------------------------- #
#                       MAIN LOGIC
# -------------------------------------------------------------------------- #

audit_cliargs
audit_age

# 'age' cannot be interrupted directly (bash defers traps until the
# foreground command exits), so each handler only ever sees a temp file
# that is incomplete or already renamed away.
trap 'cleanup_pending_outfile; exit 130' INT
trap 'cleanup_pending_outfile; exit 143' TERM
trap 'cleanup_pending_outfile; exit 129' HUP

case "${_action}" in
        'lock')         set_pubkey
                        audit_pubkey
                        encrypt_file
                        ;;
        'unlock')       set_private_key_file
                        audit_private_key_file
                        decrypt_file
                        print_secret_cleanup_msg
                        ;;
        *)              print_usage_and_exit
                        ;;
esac

exit 0
